      "agent_name": "Client Review",
      "prompt_file": ".github/prompts/client-review.md",
      "diff_paths": ["client/"]
    },
    {
      "agent_id": "general",
      "agent_name": "General Engineering Review",
      "prompt_file": ".github/prompts/general-purpose.md",
      "diff_paths": ["."],
      "exclude_paths": ["contracts/", "indexer/", "api/", "client/"]
    }
  ]
