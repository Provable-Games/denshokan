DATABASE_URL=postgres://postgres:postgres@localhost:5432/denshokan
PORT=3001

# Comma-separated CORS origin allowlist. Unset = allow any origin.
CORS_ORIGIN=http://localhost:5173

# Comma-separated allowlist of origins permitted to receive the ~40 KB
# `tokenUri` blob. Unset = any origin may (pre-allowlist behaviour).
# Requests with no Origin header (curl, server-to-server) are refused the URI
# once this is set. See api/src/utils/uriAccess.ts.
URI_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated API keys. Each entry is a bare secret or `label:secret`; the
# label shows up in boot logs and rate-limit buckets so a noisy consumer is
# identifiable. A label must not contain `:`.
#
#   API_KEYS=beasts:sk_live_abc123,warden:sk_live_def456
#
# Unset = no key is valid and every caller is anonymous. A caller presenting a
# valid key gets the `keyed` rate-limit budget and may request `tokenUri`
# without being on URI_ALLOWED_ORIGINS. Generate with:
#   node -e "console.log('sk_live_'+require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=
